+import { KotlinParser } from '../../src/parser/kotlin-parser.js';
+import { createParser, getSupportedLanguages } from '../../src/parser/index.js';
+import { detectLanguage } from '../../src/parser/types.js';
+import { NamingConventionMetric } from '../../src/metrics/naming/convention.js';
+import { createAnalyzer } from '../../src/analyzer/index.js';
+import { configSchema, createRuntimeConfig } from '../../src/config/index.js';
+import { JsonOutput } from '../../src/cli/output/json.js';
+
+const parser = new KotlinParser();
+const parse = (source: string) => parser.parse('fixture.kt', source);
+const temporaryRoot = path.resolve(process.env.TEMP ?? '../../../tests/.tmp');
+const directories: string[] = [];
+async function directory(): Promise<string> {
+  await mkdir(temporaryRoot, { recursive: true });
+  const result = await mkdtemp(path.join(temporaryRoot, 'kotlin-adapter-'));
+  directories.push(result);
+  return result;
+}
+afterEach(async () => {
+  for (const item of directories.splice(0)) {
+    if (path.dirname(item) !== temporaryRoot || !path.basename(item).startsWith('kotlin-adapter-')) {
+      throw new Error('Refusing cleanup outside adapter test root');
+    }
+    await rm(item, { recursive: true, force: true });
+  }
+});
+
+describe('Kotlin AST support', () => {
+  it('discovers Kotlin sources and scripts and initializes through the shared factory', async () => {
+    expect(detectLanguage('Main.kt')).toBe('kotlin');
+    expect(detectLanguage('build.gradle.kts')).toBe('kotlin');
+    expect(getSupportedLanguages()).toContain('kotlin');
+    expect((await (await createParser('kotlin')).parse('one.kt', 'fun one() = 1')).functions[0]?.name).toBe('one');
+  });
+  it('extracts suspend generic extension parameters and nested control flow', async () => {
+    const result = await parse(`/** Find an item. */
+suspend fun <T> List<T>.findItem(predicate: (T) -> Boolean): T? {
+    for (item in this) {
+        if (predicate(item)) return item
+    }
+    return null
+}`);
+    expect(result.functions).toHaveLength(1);
+    expect(result.functions[0]).toMatchObject({ name: 'findItem', parameterCount: 1,
+      complexity: 3, nestingDepth: 2, hasDocstring: true });
+  });
+  it('counts expression when branches but not else as an extra path', async () => {
+    const result = await parse(`fun choose(value: Int) = when (value) {
+    1 -> "one"
+    2 -> "two"
+    else -> "other"
+}`);
+    expect(result.functions[0]).toMatchObject({ name: 'choose', complexity: 3, nestingDepth: 1 });
+  });
+  it('counts boolean and elvis decisions without counting literals or comments', async () => {
+    const result = await parse(`fun active(a: Boolean, b: Boolean, text: String?): Boolean {
+    val fallback = text ?: "if && || when for"
+    // if (a || b) while (true) {}
+    return if (a && b || fallback.isNotBlank()) true else false
+}`);
+    expect(result.functions[0]).toMatchObject({ parameterCount: 3, complexity: 5, nestingDepth: 1 });
+  });
+  it('keeps Compose trailing lambdas from becoming imperative nesting', async () => {
+    const result = await parse(`import androidx.compose.runtime.Composable as Ui
+@Ui
+fun Card(content: @Ui () -> Unit) {
+    Column { Row { content() } }
+}
+@androidx.compose.runtime.Composable
+fun rememberFlag(): Boolean = true
+fun work() = 1
+fun \`escaped name\`() = 2`.replaceAll('\\`', '`'));
+    expect(result.functions.find(item => item.name === 'Card')).toMatchObject({
+      isComposable: true, returnsUnit: true, parameterCount: 1, nestingDepth: 0, complexity: 1 });
+    expect(result.functions.find(item => item.name === 'rememberFlag')).toMatchObject({ isComposable: true, returnsUnit: false });
+    expect(new NamingConventionMetric(1).calculate(result).value).toBe(100);
+  });
+  it('reports incorrectly capitalized ordinary functions', async () => {
+    const metric = new NamingConventionMetric(1).calculate(await parse('fun Bad() = 1'));
+    expect(metric.value).toBe(0);
+    expect(metric.locations?.[0]?.functionName).toBe('Bad');
+  });
+  it('extracts classes, objects, constructors, methods and property fields', async () => {
+    const result = await parse(`data class Box(val value: Int, var label: String) {
+    val doubled: Int get() = value * 2
+    constructor(value: Int): this(value, "")
+    fun read(): Int = value
+    companion object Factory { fun make() = Box(1, "") }
+}
+interface Reader { fun get(): Int }
+enum class Kind { FIRST, SECOND }`);
+    expect(result.classes.find(item => item.name === 'Box')).toMatchObject({ fieldCount: 3, methodCount: 2 });
+    expect(result.classes.map(item => item.name)).toEqual(expect.arrayContaining(['Box', 'Factory', 'Reader', 'Kind']));
+    expect(result.functions.find(item => item.name === 'constructor')?.parameterCount).toBe(1);
+    expect(result.functions.map(item => item.name)).toContain('make');
+  });
+  it('does not charge local function branches to their enclosing function', async () => {
+    const result = await parse(`fun outer(): Int {
+    fun local(flag: Boolean): Int {
+        if (flag) return 1
+        return 0
+    }
+    return local(true)
+}`);
+    expect(result.functions.find(item => item.name === 'outer')?.complexity).toBe(1);
+    expect(result.functions.find(item => item.name === 'local')?.complexity).toBe(2);
+  });
+  it('preserves Unicode names, KDoc, multiline strings and mixed code/comment lines', async () => {
+    const result = await parse('/** 中文文档 */\nfun 中文() = """if // when\n{}""" // trailing comment\n');
+    expect(result.functions[0]).toMatchObject({ name: '中文', complexity: 1, hasDocstring: true });
+    expect(result.commentLines).toBe(1);
+    expect(result.codeLines).toBe(2);
+    expect(result.totalLines).toBe(result.codeLines + result.commentLines + result.blankLines);
+  });
+  it('fails explicitly on an incomplete tree instead of inventing regex metrics', async () => {
+    await expect(parse('fun broken( {')).rejects.toThrow('Incomplete Kotlin AST');
+  });
+  it('includes complete Kotlin scripts and reports failed file coverage in JSON', async () => {
+    const root = await directory();
+    await writeFile(path.join(root, 'good.kts'), 'fun task() = 1\nprintln(task())');
+    await writeFile(path.join(root, 'broken.kt'), 'fun broken( {');
+    const result = await createAnalyzer(createRuntimeConfig(root, configSchema.parse({ ai: { enabled: false } }))).analyze();
+    expect(result.analyzedFiles).toBe(1);
+    expect(result.skippedFiles).toBe(1);
+    expect(result.failedFiles).toEqual(['broken.kt']);
+    expect(result.fileResults[0]?.parseResult.language).toBe('kotlin');
+    const json = JSON.parse(new JsonOutput().render(result));
+    expect(json.failedFiles).toEqual(['broken.kt']);
+    expect(json.scoreScope).toBe('complete-files-only');
+    expect(json.limitations.join(' ')).toContain('heuristics');
+  });
+  it('does not return a perfect score when every Kotlin file fails', async () => {
+    const root = await directory();
+    await writeFile(path.join(root, 'broken.kt'), 'fun broken( {');
+    await expect(createAnalyzer(createRuntimeConfig(root, configSchema.parse({}))).analyze()).rejects.toThrow('score is N/A');
+  });
+});
