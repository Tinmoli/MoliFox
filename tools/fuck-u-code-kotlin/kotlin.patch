diff --git a/src/parser/kotlin-parser.ts b/src/parser/kotlin-parser.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a51b7875e7deb42b1810f39b8160d47f3e85cb9c
--- /dev/null
+++ b/src/parser/kotlin-parser.ts
@@ -0,0 +1,178 @@
+/** Kotlin AST adapter. Parse errors are fatal; incomplete trees must never earn a score. */
+import { Parser as TreeSitter, Language as KotlinLanguage, type Node } from '@willbooster/web-tree-sitter';
+import { createRequire } from 'node:module';
+import type { Parser, ParseResult, FunctionInfo, ClassInfo, Language } from './types.js';
+
+const functionTypes = new Set(['function_declaration', 'secondary_constructor']);
+const classTypes = new Set(['class_declaration', 'object_declaration', 'companion_object']);
+const controlTypes = new Set([
+  'if_expression', 'for_statement', 'while_statement', 'do_while_statement',
+  'when_expression', 'catch_block',
+]);
+
+function walk(node: Node, action: (node: Node) => void): void {
+  action(node);
+  for (const child of node.namedChildren) walk(child, action);
+}
+
+function child(node: Node, type: string): Node | undefined {
+  return node.namedChildren.find(item => item.type === type);
+}
+
+function unescapeName(name: string): string {
+  return name.startsWith('`') && name.endsWith('`') ? name.slice(1, -1) : name;
+}
+
+/** Branch count and structural cognitive complexity; not a compiler or Sonar equivalence claim. */
+function flow(body: Node): { complexity: number; nestingDepth: number; cognitiveComplexity: number } {
+  let complexity = 1;
+  let nestingDepth = 0;
+  let cognitiveComplexity = 0;
+  function visit(node: Node, depth: number): void {
+    if (functionTypes.has(node.type) || classTypes.has(node.type)) return;
+    const control = controlTypes.has(node.type);
+    const whenBranch = node.type === 'when_entry' && !node.children.some(item => item.type === 'else');
+    const logical = node.type === 'binary_expression' &&
+      ['&&', '||', '?:'].includes(node.childForFieldName('operator')?.text ?? '');
+    if ((control && node.type !== 'when_expression') || whenBranch || logical) complexity++;
+    if (control) {
+      cognitiveComplexity += 1 + depth;
+      nestingDepth = Math.max(nestingDepth, depth + 1);
+    } else if (logical) cognitiveComplexity++;
+    for (const item of node.namedChildren) visit(item, depth + (control ? 1 : 0));
+  }
+  visit(body, 0);
+  return { complexity, nestingDepth, cognitiveComplexity };
+}
+
+function functionInfo(node: Node, composableNames: Set<string>): FunctionInfo | null {
+  const params = child(node, 'function_value_parameters');
+  const nameNode = node.childForFieldName('name');
+  const constructor = node.type === 'secondary_constructor';
+  const rawName = constructor ? 'constructor' : nameNode?.text;
+  if (!rawName) return null;
+  const body = child(node, 'function_body') ?? child(node, 'block');
+  const modifiers = child(node, 'modifiers');
+  let isComposable = false;
+  if (modifiers) walk(modifiers, item => {
+    if (item.type !== 'annotation') return;
+    const name = /^@(?:\w+:)?([\w.]+)/.exec(item.text)?.[1]?.split('.').at(-1);
+    if (name && composableNames.has(name)) isComposable = true;
+  });
+  const type = params && node.namedChildren.find(item =>
+    item.startIndex > params.endIndex && item !== body &&
+    ['user_type', 'nullable_type', 'function_type', 'dynamic'].includes(item.type));
+  const returnsUnit = type ? type.text === 'Unit' || type.text === 'kotlin.Unit' :
+    body?.children.some(item => item.type === '=') ? undefined : true;
+  const previous = node.previousNamedSibling;
+  const metrics = body ? flow(body) : { complexity: 1, nestingDepth: 0, cognitiveComplexity: 0 };
+  // Named local functions have their own metrics; keep their bodies out of parent size.
+  let nestedLines = 0;
+  function localLines(item: Node): void {
+    for (const nested of item.namedChildren) {
+      if (functionTypes.has(nested.type) || classTypes.has(nested.type)) {
+        if (nested.startPosition.row > node.startPosition.row && nested.endPosition.row < node.endPosition.row) {
+          nestedLines += nested.endPosition.row - nested.startPosition.row + 1;
+        }
+      } else localLines(nested);
+    }
+  }
+  if (body) localLines(body);
+  return {
+    name: unescapeName(rawName), startLine: node.startPosition.row + 1,
+    endLine: node.endPosition.row + 1,
+    lineCount: Math.max(1, node.endPosition.row - node.startPosition.row + 1 - nestedLines),
+    parameterCount: params?.namedChildren.filter(item => item.type === 'parameter').length ?? 0,
+    hasDocstring: previous?.type === 'block_comment' && previous.text.startsWith('/**'),
+    isComposable, returnsUnit, escapedName: rawName.startsWith('`'), ...metrics,
+  };
+}
+
+function classInfo(node: Node): ClassInfo | null {
+  const name = node.childForFieldName('name');
+  if (!name && node.type !== 'companion_object') return null;
+  const body = child(node, 'class_body') ?? child(node, 'enum_class_body');
+  const members = body?.namedChildren ?? [];
+  const primary = child(node, 'primary_constructor');
+  const fields = primary?.descendantsOfType('class_parameter').filter(item =>
+    item.children.some(token => token.type === 'val' || token.type === 'var')).length ?? 0;
+  return {
+    name: name ? unescapeName(name.text) : 'Companion', startLine: node.startPosition.row + 1,
+    endLine: node.endPosition.row + 1,
+    methodCount: members.filter(item => functionTypes.has(item.type)).length,
+    fieldCount: fields + members.filter(item => item.type === 'property_declaration').length,
+  };
+}
+
+function lineCounts(content: string, comments: Node[]): Pick<ParseResult, 'totalLines' | 'blankLines' | 'codeLines' | 'commentLines'> {
+  let position = 0;
+  let withoutComments = '';
+  for (const comment of comments.sort((a, b) => a.startIndex - b.startIndex)) {
+    if (comment.startIndex < position) continue;
+    withoutComments += content.slice(position, comment.startIndex) + comment.text.replace(/[^\r\n]/g, ' ');
+    position = comment.endIndex;
+  }
+  withoutComments += content.slice(position);
+  const lines = content.split('\n');
+  const code = withoutComments.split('\n');
+  let blankLines = 0;
+  let commentLines = 0;
+  let codeLines = 0;
+  lines.forEach((line, index) => {
+    if (!line.trim()) blankLines++;
+    else if (!code[index]?.trim()) commentLines++;
+    else codeLines++;
+  });
+  return { totalLines: lines.length, blankLines, commentLines, codeLines };
+}
+
+export class KotlinParser implements Parser {
+  private parser: TreeSitter | undefined;
+  async initialize(): Promise<void> {
+    if (this.parser) return;
+    await TreeSitter.init();
+    const require = createRequire(import.meta.url);
+    const language = await KotlinLanguage.load(require.resolve('@willbooster/tree-sitter-kotlin/tree-sitter-kotlin.wasm'));
+    this.parser = new TreeSitter();
+    this.parser.setLanguage(language);
+  }
+  supportedLanguages(): Language[] { return ['kotlin']; }
+  async parse(filePath: string, content: string): Promise<ParseResult> {
+    await this.initialize();
+    if (!this.parser) throw new Error('Kotlin parser unavailable');
+    const tree = this.parser.parse(content);
+    if (!tree) throw new Error('Kotlin parse cancelled before completion');
+    try {
+      const errors: string[] = [];
+      const comments: Node[] = [];
+      const declarations: Node[] = [];
+      const imports: string[] = [];
+      walk(tree.rootNode, node => {
+        if (node.type === 'ERROR' || node.isMissing) {
+          errors.push(`${filePath}:${node.startPosition.row + 1}:${node.startPosition.column + 1} ${node.type}`);
+        }
+        if (node.type === 'line_comment' || node.type === 'block_comment') comments.push(node);
+        if (functionTypes.has(node.type) || classTypes.has(node.type)) declarations.push(node);
+        if (node.type === 'import') imports.push(node.text.replace(/^import\s+/, ''));
+      });
+      if (errors.length) throw new Error(`Incomplete Kotlin AST (${errors.length} nodes): ${errors.slice(0, 12).join('; ')}`);
+      const composableNames = new Set(['Composable']);
+      for (const imported of imports) {
+        const alias = /(?:^|\.)Composable\s+as\s+(\w+)$/.exec(imported)?.[1];
+        if (alias) composableNames.add(alias);
+      }
+      const functions: FunctionInfo[] = [];
+      const classes: ClassInfo[] = [];
+      for (const declaration of declarations) {
+        if (functionTypes.has(declaration.type)) {
+          const info = functionInfo(declaration, composableNames);
+          if (info) functions.push(info);
+        } else {
+          const info = classInfo(declaration);
+          if (info) classes.push(info);
+        }
+      }
+      return { filePath, language: 'kotlin', parserKind: 'ast', ...lineCounts(content, comments), functions, classes, imports, errors: [] };
+    } finally { tree.delete(); }
+  }
+}
